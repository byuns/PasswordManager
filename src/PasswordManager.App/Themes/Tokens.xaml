<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        디자인 토큰 (TD-023 / design-ux.md 5절)
        - 강조색(인디고)은 App.xaml.cs에서 ApplicationAccentColorManager로 적용.
        - 배경/표면/텍스트 색은 WPF-UI Dark 토큰(DynamicResource)에 의존한다.
        - 여기서는 여백 스케일과 카드 형태만 정의한다.
    -->

    <!-- 여백 스케일 (px): 4 · 8 · 12 · 16 · 24 -->
    <sys:Double x:Key="SpacingXS">4</sys:Double>
    <sys:Double x:Key="SpacingS">8</sys:Double>
    <sys:Double x:Key="SpacingM">12</sys:Double>
    <sys:Double x:Key="SpacingL">16</sys:Double>
    <sys:Double x:Key="SpacingXL">24</sys:Double>

    <!-- Margin/Padding용 균일 Thickness (위 스케일과 동일 값) -->
    <Thickness x:Key="ThicknessXS">4</Thickness>
    <Thickness x:Key="ThicknessS">8</Thickness>
    <Thickness x:Key="ThicknessM">12</Thickness>
    <Thickness x:Key="ThicknessL">16</Thickness>
    <Thickness x:Key="ThicknessXL">24</Thickness>

    <!-- 카드 형태 -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <!--
        카드 Border 스타일 (항목 카드 등에서 사용, 3단계에서 활용).
        은은한 표면·테두리 + 호버 시 강조색 테두리.
    -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource ThicknessL}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
