<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PasswordManager.Core\PasswordManager.Core.csproj" />
    <ProjectReference Include="..\PasswordManager.Storage\PasswordManager.Storage.csproj" />
    <ProjectReference Include="..\PasswordManager.ViewModels\PasswordManager.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- 배포 메타데이터. exe 이름을 PasswordManager.exe로 줄이고, 정보 화면의 버전 표시(GetAppVersion)와
       작업표시줄 아이콘이 여기서 나온다. RuntimeIdentifier·단일 파일 옵션은 csproj에 박지 않고
       publish 명령에서 준다 — 일반 빌드 산출물 경로가 RID별로 갈라지는 걸 피하기 위함(README 참고). -->
  <PropertyGroup>
    <AssemblyName>PasswordManager</AssemblyName>
    <RootNamespace>PasswordManager.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>PasswordManager</Product>
    <Description>로컬 전용 비밀번호 관리자</Description>
    <Version>1.1.0</Version>
  </PropertyGroup>

</Project>
