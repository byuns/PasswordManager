<ui:FluentWindow x:Class="PasswordManager.App.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
                 d:DataContext="{d:DesignInstance vm:ShellViewModel}"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="PasswordManager" Height="560" Width="880"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="PasswordManager" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 사이드바 레일 (열림 모드 · 최상위 페이지에서만 노출) -->
            <Border Grid.Column="0" Width="150"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="8">
                    <ui:Button DockPanel.Dock="Bottom" Icon="{ui:SymbolIcon LockClosed24}"
                               Appearance="Transparent" ToolTip="잠금"
                               HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                               Command="{Binding LockCommand}" Margin="0,4,0,0" />
                    <StackPanel>
                        <ui:Button Content="항목" Icon="{ui:SymbolIcon Key24}"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Command="{Binding ShowItemsCommand}"
                                   Margin="0,0,0,4" />
                        <ui:Button Content="설정" Icon="{ui:SymbolIcon Settings24}"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Command="{Binding ShowSettingsCommand}"
                                   Margin="0,0,0,4" />
                        <ui:Button Content="정보" Icon="{ui:SymbolIcon Info24}"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Command="{Binding ShowInfoCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
