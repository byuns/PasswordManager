<ui:FluentWindow x:Class="PasswordManager.App.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
                 d:DataContext="{d:DesignInstance vm:ShellViewModel}"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="PasswordManager" Height="560" Width="880"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0">
            <!-- 세션 제어(잠금)를 헤더 최좌측으로: [잠금][제목] 순. 열림 상태(최상위 페이지)에서만 잠금 노출 -->
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <ui:Button Icon="{ui:SymbolIcon LockClosed24}" ToolTip="잠금"
                               Appearance="Transparent" Padding="6,2" Margin="0,0,8,0" FontSize="13"
                               Command="{Binding LockCommand}"
                               Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="PasswordManager" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 사이드바 레일 (열림 모드 · 최상위 페이지에서만 노출) -->
            <Border Grid.Column="0" Width="150"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="8">
                    <StackPanel>
                        <ui:Button Content="계정" Icon="{ui:SymbolIcon Key24}"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Command="{Binding ShowItemsCommand}"
                                   Margin="0,0,0,4" />
                        <ui:Button Content="설정" Icon="{ui:SymbolIcon Settings24}"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Command="{Binding ShowSettingsCommand}"
                                   Margin="0,0,0,4" />
                        <ui:Button Content="메뉴얼" Icon="{ui:SymbolIcon BookQuestionMark24}"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Command="{Binding ShowManualCommand}"
                                   Margin="0,0,0,4" />
                        <ui:Button Content="정보" Icon="{ui:SymbolIcon Info24}"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Command="{Binding ShowInfoCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- 완료 토스트 호스트: 본문 위에 겹쳐 그린다(코드 비하인드가 서비스에 연결). -->
        <ui:SnackbarPresenter x:Name="RootSnackbar" Grid.Row="0" Grid.RowSpan="2"
                              MaxWidth="420" Margin="0,0,0,32"
                              HorizontalAlignment="Center" VerticalAlignment="Bottom" />

        <!-- 삭제 등 확인 오버레이: 배경 딤 + 단일 카드(상/하단 띠 없는 평평한 디자인). 평소 숨김.
             Tab이 뒤 화면으로 새지 않도록 카드 안에서만 순환(포커스 트랩). 마우스는 딤 배경이 막는다. -->
        <Grid x:Name="ConfirmOverlay" Grid.Row="0" Grid.RowSpan="2"
              Background="#99000000" Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border MaxWidth="360" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="24">
                <StackPanel>
                    <ui:TextBlock x:Name="ConfirmTitle" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock x:Name="ConfirmMessage" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <ui:Button x:Name="ConfirmCancelButton" Content="취소" MinWidth="84"
                                   IsCancel="True" Click="OnConfirmCancel" Margin="0,0,8,0" />
                        <ui:Button x:Name="ConfirmOkButton" Content="삭제" MinWidth="84"
                                   Appearance="Danger" IsDefault="True" Click="OnConfirmOk" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
