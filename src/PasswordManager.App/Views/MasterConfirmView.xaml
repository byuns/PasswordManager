<UserControl x:Class="PasswordManager.App.Views.MasterConfirmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:MasterConfirmViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="FormScroll">
    <Grid MinHeight="{Binding ViewportHeight, ElementName=FormScroll}">
    <Border MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="40">
        <StackPanel>
            <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Margin="0,0,0,12" />
            <ui:TextBlock FontTypography="Title" Text="마스터 비밀번호 확인" HorizontalAlignment="Center"
                          Margin="0,0,0,8" />
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Prompt}" TextWrapping="Wrap" HorizontalAlignment="Center"
                          TextAlignment="Center" Margin="0,0,0,20" />

            <ui:PasswordBox x:Name="PasswordInput" PlaceholderText="마스터 비밀번호"
                            PasswordChanged="PasswordInput_PasswordChanged" />

            <ui:TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                          Text="{Binding ErrorMessage}"
                          Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
                          TextWrapping="Wrap" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="취소" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <ui:Button Content="확인" Appearance="Primary" IsDefault="True"
                           Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
