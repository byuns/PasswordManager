<UserControl x:Class="PasswordManager.App.Views.OtpGateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:OtpGateViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
        <StackPanel>
            <ui:TextBlock FontTypography="Title" Text="비밀번호 보기" Margin="0,0,0,4" />
            <ui:TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Margin="0,0,0,16" />

            <ui:TextBlock Text="폰의 6자리 코드를 입력하세요." Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding VerificationCode, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="8" PlaceholderText="123456" />

            <ui:TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                          Text="{Binding ErrorMessage}"
                          Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
                          TextWrapping="Wrap" Margin="0,8,0,0" />

            <!-- 검증 성공 후에만 표시되는 평문 비밀번호 -->
            <StackPanel Visibility="{Binding RevealedPassword, Converter={StaticResource StringNotEmptyToVisibility}}"
                        Margin="0,12,0,0">
                <ui:TextBlock Text="비밀번호" Margin="0,0,0,4" />
                <ui:TextBox Text="{Binding RevealedPassword, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" />
                <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{Binding LastChangedAt, StringFormat='마지막 변경: {0:yyyy-MM-dd}'}"
                              Margin="0,4,0,0" />

                <!-- 이전 비밀번호 이력(옛 비번도 secret → 게이트 통과 후에만, TD-021) -->
                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding RevealedHistory.Count, Converter={StaticResource CountToVisibility}}">
                    <ui:TextBlock Text="이전 비밀번호" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding RevealedHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" Text="{Binding Password, Mode=OneWay}"
                                                IsReadOnly="True" FontFamily="Consolas" />
                                    <ui:TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Text="{Binding ChangedAt, StringFormat='{}{0:yyyy-MM-dd}'}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="닫기" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <ui:Button Content="보기" Appearance="Primary" Command="{Binding RevealCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
