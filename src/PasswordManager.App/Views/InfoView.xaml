<UserControl x:Class="PasswordManager.App.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:InfoViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel Margin="24" MaxWidth="680" HorizontalAlignment="Left">
        <ui:TextBlock FontTypography="Title" Text="정보" Margin="0,0,0,20" />

        <!-- 라벨(왼쪽) + 값(오른쪽)을 한 그리드로 맞춰 정렬 -->
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBlock Grid.Row="0" Grid.Column="0" Text="이름" VerticalAlignment="Top"
                              Margin="0,0,32,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppName}" VerticalAlignment="Top"
                              FontTypography="BodyStrong" Margin="0,0,0,12" />

                <ui:TextBlock Grid.Row="1" Grid.Column="0" Text="설명" VerticalAlignment="Top"
                              Margin="0,0,32,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="로컬 비밀번호 매니저" VerticalAlignment="Top"
                              Margin="0,0,0,12" />

                <ui:TextBlock Grid.Row="2" Grid.Column="0" Text="버전" VerticalAlignment="Top"
                              Margin="0,0,32,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Top"
                              Margin="0,0,0,12" />

                <ui:TextBlock Grid.Row="3" Grid.Column="0" Text="볼트 위치" VerticalAlignment="Top"
                              Margin="0,0,32,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VaultPath}" VerticalAlignment="Top"
                              TextWrapping="Wrap" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
