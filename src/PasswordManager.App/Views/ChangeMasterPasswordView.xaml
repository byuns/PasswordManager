<UserControl x:Class="PasswordManager.App.Views.ChangeMasterPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:ChangeMasterPasswordViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="40">
        <StackPanel>
            <ui:SymbolIcon Symbol="Key24" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Margin="0,0,0,12" />
            <ui:TextBlock FontTypography="Title" Text="마스터 비밀번호 변경" HorizontalAlignment="Center"
                          Margin="0,0,0,24" />

            <ui:TextBlock Text="현재 비밀번호" Margin="0,0,0,4" />
            <ui:PasswordBox x:Name="CurrentInput" PlaceholderText="현재 비밀번호"
                            PasswordChanged="CurrentInput_PasswordChanged" />

            <ui:TextBlock Text="새 비밀번호" Margin="0,12,0,4" />
            <ui:PasswordBox x:Name="NewPasswordInput" PlaceholderText="새 비밀번호"
                            PasswordChanged="NewPasswordInput_PasswordChanged" />

            <ui:TextBlock Text="새 비밀번호 확인" Margin="0,12,0,4" />
            <ui:PasswordBox x:Name="ConfirmInput" PlaceholderText="한 번 더 입력"
                            PasswordChanged="ConfirmInput_PasswordChanged" />

            <ui:TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                          Text="{Binding ErrorMessage}"
                          Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
                          TextWrapping="Wrap" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="취소" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <ui:Button Content="변경" Appearance="Primary" IsDefault="True" Command="{Binding ChangeCommand}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
            <ProgressBar IsIndeterminate="True" Margin="0,12,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
