<UserControl x:Class="PasswordManager.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <DockPanel Margin="16">
        <!-- 상단 도구모음 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="검색 (제목·아이디)"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Content="새 항목" Icon="{ui:SymbolIcon Add24}"
                       Appearance="Primary" Margin="8,0,0,0" Command="{Binding NewEntryCommand}" />
            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ShieldKeyhole24}"
                       ToolTip="OTP 등록/재설정 (2단계 인증)"
                       Margin="8,0,0,0" Command="{Binding SetupOtpCommand}" />
            <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Key24}" ToolTip="마스터 비밀번호 변경"
                       Margin="8,0,0,0" Command="{Binding ChangeMasterPasswordCommand}" />
            <ui:Button Grid.Column="4" Content="잠금" Icon="{ui:SymbolIcon LockClosed24}"
                       Margin="8,0,0,0" Command="{Binding LockCommand}" />
        </Grid>

        <!-- 하단 동작 버튼 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding StatusMessage}" TextWrapping="Wrap"
                          Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="보기" Icon="{ui:SymbolIcon Eye24}"
                           Command="{Binding RevealCommand}" Margin="0,0,8,0" />
                <ui:Button Content="편집" Icon="{ui:SymbolIcon Edit24}"
                           Command="{Binding EditCommand}" Margin="0,0,8,0" />
                <ui:Button Content="삭제" Icon="{ui:SymbolIcon Delete24}"
                           Appearance="Danger" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </Grid>

        <!-- 항목 목록 -->
        <ListView ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="제목" Width="200" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="아이디" Width="220" DisplayMemberBinding="{Binding Login}" />
                    <GridViewColumn Header="주소" Width="260" DisplayMemberBinding="{Binding Url}" />
                    <GridViewColumn Header="마지막 변경" Width="120"
                                    DisplayMemberBinding="{Binding LastChangedAt, StringFormat='{}{0:yyyy-MM-dd}'}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
