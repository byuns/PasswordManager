<UserControl x:Class="PasswordManager.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- 태그 필터 칩: 각진 버튼 대신 둥근 알약. 켜지면 강조색, 아니면 은은한 배경 -->
        <Style x:Key="TagChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ChipScale" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <!-- 누르는 순간 살짝 눌림(scale) → 떼면 복귀. 가벼운 촉감 피드백 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.92" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.92" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="{StaticResource ThicknessL}">
        <!-- 상단 도구모음: 검색 + 새 항목 (보조 동작은 설정 화면으로 이전) -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="검색 (사이트·아이디)"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Add24}" ToolTip="새 계정"
                       Appearance="Primary" Width="36" Height="36" Padding="0"
                       CornerRadius="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                       Margin="8,0,0,0" Command="{Binding NewEntryCommand}" />
        </Grid>

        <!-- 태그 필터 칩 바 (TD-029: 여러 개 선택 시 OR). 태그가 있을 때만 표시 -->
        <!-- 높이 고정: '지우기' 버튼(선택 시 등장)이 바를 키우지 않도록 칩 높이에 맞춰 Height를 못박는다. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16" Height="28"
              Visibility="{Binding AvailableTags.Count, Converter={StaticResource CountToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 태그가 많아도 세로 공간을 잡아먹지 않도록 한 줄 고정(TD-030). 스크롤바는 디자인을 해쳐
                 숨기고, 마우스 휠로 가로 슬라이딩한다(코드비하인드 TagScroll_PreviewMouseWheel). -->
            <ScrollViewer x:Name="TagScroll" Grid.Column="0"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="TagScroll_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding AvailableTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource TagChipStyle}" Margin="0,0,6,0"
                                          Command="{Binding DataContext.ToggleTagCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}">
                                <ToggleButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource TagSelected}" Mode="OneWay">
                                        <Binding />
                                        <Binding Path="DataContext.SelectedTags"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </ToggleButton.IsChecked>
                                <TextBlock Text="{Binding StringFormat='#{0}'}" />
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ui:Button Grid.Column="1" Content="지우기" Icon="{ui:SymbolIcon Dismiss24}"
                       Appearance="Secondary" Margin="8,0,0,0" VerticalAlignment="Center"
                       Height="28" Padding="10,0" FontSize="12"
                       Command="{Binding ClearTagsCommand}"
                       Visibility="{Binding SelectedTags.Count, Converter={StaticResource CountToVisibility}}" />
        </Grid>

        <!-- 상태 안내 (예: OTP 미등록 시 열람 안내) -->
        <ui:TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{Binding StatusMessage}" TextWrapping="Wrap"
                      Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />

        <!-- 계정 카드 리스트 (design-ux §4). 최초로 열릴 때만 목록 영역이 은은하게 fade-in(필터/검색 갱신엔 재생 안 됨). -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" Opacity="0">
            <ScrollViewer.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ScrollViewer.Triggers>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 사이트 그룹 카드: 헤더(아바타+사이트명) + 계정 행들 -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- 사이트 헤더 -->
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="20"
                                            Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SiteName, Converter={StaticResource Initial}}"
                                                   Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding SiteName}"
                                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                                  TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- 계정 행들 -->
                                <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="52,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 아이디(+복사) -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:TextBlock Text="{Binding Login}" VerticalAlignment="Center"
                                                                  TextTrimming="CharacterEllipsis"
                                                                  ToolTipService.InitialShowDelay="300"
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <!-- 메모 미리보기: 민감정보 미기재 전제로 OTP 없이 hover로 짧게 노출 -->
                                                        <ToolTipService.ToolTip>
                                                            <Binding Converter="{StaticResource EntryNotesTooltip}" />
                                                        </ToolTipService.ToolTip>
                                                    </ui:TextBlock>
                                                    <ui:Button Padding="4" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Icon="{ui:SymbolIcon Copy16}" FontSize="11" ToolTip="아이디 복사"
                                                               Visibility="{Binding Login, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                               Command="{Binding DataContext.CopyLoginCommand,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding Login}" />
                                                </StackPanel>

                                                <!-- 태그 + 액션 (태그는 버튼 왼쪽 인라인. 변경일은 목록에서 생략, OTP 열람 시 표시) -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <!-- 태그 칩 (최대 2개) -->
                                                    <ItemsControl VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <ItemsControl.ItemsSource>
                                                            <Binding Path="Tags" Converter="{StaticResource LimitTags}" ConverterParameter="2" />
                                                        </ItemsControl.ItemsSource>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                        CornerRadius="4" Padding="6,1" Margin="4,0,0,0">
                                                                    <ui:TextBlock FontTypography="Caption" Text="{Binding}"
                                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- 인증 전엔 인증/등록 버튼, OTP 통과 후 보기/편집/삭제 3버튼으로 전환 -->
                                                    <Grid>
                                                        <!-- 미인증 슬롯: OTP 등록 여부에 따라 '인증' 또는 'OTP 등록' -->
                                                        <Grid>
                                                            <Grid.Visibility>
                                                                <MultiBinding Converter="{StaticResource EntryVerified}"
                                                                              ConverterParameter="unverified" Mode="OneWay">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.OtpVerifiedIds"
                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </Grid.Visibility>
                                                            <!-- OTP 등록됨: 자물쇠 '인증' -->
                                                            <ui:Button Icon="{ui:SymbolIcon LockClosed24}" ToolTip="인증"
                                                                       Appearance="Transparent"
                                                                       Visibility="{Binding DataContext.HasOtp,
                                                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                                                    Converter={StaticResource BoolToVisibility}}"
                                                                       Command="{Binding DataContext.VerifyCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}" />
                                                            <!-- OTP 미등록: 등록 화면으로 유도 -->
                                                            <ui:Button Content="OTP 등록" Icon="{ui:SymbolIcon Key24}"
                                                                       Appearance="Secondary"
                                                                       Visibility="{Binding DataContext.RequiresOtpSetup,
                                                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                                                    Converter={StaticResource BoolToVisibility}}"
                                                                       Command="{Binding DataContext.VerifyCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}" />
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Visibility>
                                                                <MultiBinding Converter="{StaticResource EntryVerified}"
                                                                              ConverterParameter="verified" Mode="OneWay">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.OtpVerifiedIds"
                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </StackPanel.Visibility>
                                                            <ui:Button Icon="{ui:SymbolIcon Eye24}" ToolTip="보기"
                                                                       Command="{Binding DataContext.RevealCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}" />
                                                            <ui:Button Icon="{ui:SymbolIcon Edit24}" ToolTip="편집" Margin="4,0,0,0"
                                                                       Command="{Binding DataContext.EditCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}" />
                                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="삭제" Margin="4,0,0,0"
                                                                       Appearance="Danger"
                                                                       Command="{Binding DataContext.DeleteCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
