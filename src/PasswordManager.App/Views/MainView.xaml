<UserControl x:Class="PasswordManager.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Loaded="MainView_Loaded">
    <!-- 키보드 단축키(design-ux §5). 인자 없는 커맨드는 SelectedEntry로 폴백한다.
         Ctrl+F만 포커스 이동이라 뷰의 몫 → ApplicationCommands.Find로 코드비하인드에 넘긴다. -->
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch_Executed" />
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="ApplicationCommands.Find" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewEntryCommand}" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding LockCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding CopySelectedLoginCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ClearFiltersCommand}" />
        <KeyBinding Key="Down" Command="{Binding SelectNextCommand}" />
        <KeyBinding Key="Up" Command="{Binding SelectPreviousCommand}" />
        <KeyBinding Key="Enter" Command="{Binding VerifyCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- 태그 필터 칩: 각진 버튼 대신 둥근 알약. 켜지면 강조색, 아니면 은은한 배경 -->
        <Style x:Key="TagChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ChipScale" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <!-- 누르는 순간 살짝 눌림(scale) → 떼면 복귀. 가벼운 촉감 피드백 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.92" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.92" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="{StaticResource ThicknessL}">
        <!-- 상단 도구모음: 검색 + 새 항목 (보조 동작은 설정 화면으로 이전) -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="검색 (사이트·아이디·태그) — Ctrl+F"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
            <!-- 정렬 기준 (TD-040). 고른 값은 볼트에 저장돼 다음 실행에도 유지된다. -->
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="118" VerticalAlignment="Center"
                      ToolTip="정렬 기준"
                      ItemsSource="{Binding SortOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Order"
                      SelectedValue="{Binding SortOrder}" />
            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Add24}" ToolTip="새 계정"
                       Appearance="Primary" Width="36" Height="36" Padding="0"
                       CornerRadius="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                       Margin="8,0,0,0" Command="{Binding NewEntryCommand}" />
        </Grid>

        <!-- 태그 필터 칩 바 (TD-029: 여러 개 선택 시 OR). 태그가 있을 때만 표시 -->
        <!-- 높이 고정: '지우기' 버튼(선택 시 등장)이 바를 키우지 않도록 칩 높이에 맞춰 Height를 못박는다. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16" Height="28"
              Visibility="{Binding AvailableTags.Count, Converter={StaticResource CountToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 태그가 많아도 세로 공간을 잡아먹지 않도록 한 줄 고정(TD-030). 스크롤바는 디자인을 해쳐
                 숨기고, 마우스 휠로 가로 슬라이딩한다(코드비하인드 TagScroll_PreviewMouseWheel). -->
            <ScrollViewer x:Name="TagScroll" Grid.Column="0"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="TagScroll_PreviewMouseWheel">
                <!-- 오른쪽 끝을 살짝 투명하게(페이드) 해 "옆에 태그가 더 있음"을 암시(TD-030 가로 스크롤 어포던스) -->
                <ScrollViewer.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Black" />
                        <GradientStop Offset="0.92" Color="Black" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </ScrollViewer.OpacityMask>
                <ItemsControl ItemsSource="{Binding AvailableTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource TagChipStyle}" Margin="0,0,6,0"
                                          Command="{Binding DataContext.ToggleTagCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}">
                                <ToggleButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource TagSelected}" Mode="OneWay">
                                        <Binding />
                                        <Binding Path="DataContext.SelectedTags"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </ToggleButton.IsChecked>
                                <TextBlock Text="{Binding StringFormat='#{0}'}" />
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ui:Button Grid.Column="1" Content="지우기" Icon="{ui:SymbolIcon Dismiss24}"
                       Appearance="Secondary" Margin="8,0,0,0" VerticalAlignment="Center"
                       Height="28" Padding="10,0" FontSize="12"
                       Command="{Binding ClearTagsCommand}"
                       Visibility="{Binding SelectedTags.Count, Converter={StaticResource CountToVisibility}}" />
        </Grid>

        <!-- 상태 안내 (예: OTP 미등록 시 열람 안내) -->
        <ui:TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{Binding StatusMessage}" TextWrapping="Wrap"
                      Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />

        <!-- 계정 카드 리스트 (design-ux §4). 화면 전환 fade는 셸(ContentControl)이 전담한다. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 사이트 그룹 카드: 헤더(아바타+사이트명) + 계정 행들 -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- 사이트 헤더 (즐겨찾기 그룹이면 이니셜 대신 별 배지) -->
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="40" Height="40" VerticalAlignment="Center">
                                        <Border x:Name="Avatar" CornerRadius="20"
                                                Background="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                            <TextBlock Text="{Binding SiteName, Converter={StaticResource Initial}}"
                                                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="FavoritesBadge" CornerRadius="20" Visibility="Collapsed"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="20"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding SiteName}"
                                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                                  TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- 계정 행들 -->
                                <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 행 클릭·↑↓로 선택되며, 선택 시 옅은 배경만 깔린다.
                                                 (사이드바와 달리 좌측 강조 바는 두지 않는다 — 행이 촘촘해 산만해짐) -->
                                            <Grid Margin="0,6,0,0" Background="Transparent"
                                                  PreviewMouseLeftButtonDown="AccountRow_MouseLeftButtonDown">
                                                <Border CornerRadius="6"
                                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource EntrySelected}" Mode="OneWay">
                                                            <Binding />
                                                            <Binding Path="DataContext.SelectedEntry"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </Border.Visibility>
                                                </Border>
                                                <Grid Margin="52,4,8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 즐겨찾기 + 아이디(+복사) -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- 핀은 비밀 노출이 아니라 인증 없이 바로 토글된다(TD-040) -->
                                                    <ui:Button Appearance="Transparent" Padding="2" Margin="0,0,6,0"
                                                               VerticalAlignment="Center" ToolTip="즐겨찾기"
                                                               Command="{Binding DataContext.TogglePinCommand,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}">
                                                        <ui:SymbolIcon x:Name="PinIcon" Symbol="Star24" FontSize="15"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </ui:Button>
                                                    <!-- 즐겨찾기 그룹에서는 어떤 사이트인지 알 수 없으므로 사이트명을 앞에 붙인다 -->
                                                    <ui:TextBlock x:Name="SiteInline" Visibility="Collapsed"
                                                                  FontTypography="BodyStrong" Text="{Binding Title}"
                                                                  VerticalAlignment="Center"
                                                                  TextTrimming="CharacterEllipsis" />
                                                    <ui:TextBlock x:Name="SiteSeparator" Visibility="Collapsed"
                                                                  Text="·" Margin="6,0,6,0" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <ui:TextBlock Text="{Binding Login}" VerticalAlignment="Center"
                                                                  TextTrimming="CharacterEllipsis"
                                                                  ToolTipService.InitialShowDelay="300"
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <!-- 메모 미리보기: 민감정보 미기재 전제로 OTP 없이 hover로 짧게 노출 -->
                                                        <ToolTipService.ToolTip>
                                                            <Binding Converter="{StaticResource EntryNotesTooltip}" />
                                                        </ToolTipService.ToolTip>
                                                    </ui:TextBlock>
                                                    <ui:Button Padding="4" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Icon="{ui:SymbolIcon Copy16}" FontSize="11" ToolTip="아이디 복사"
                                                               Visibility="{Binding Login, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                               Command="{Binding DataContext.CopyLoginCommand,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding Login}" />
                                                </StackPanel>

                                                <!-- 태그 + 액션 (태그는 버튼 왼쪽 인라인. 변경일은 목록에서 생략, OTP 열람 시 표시) -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <!-- 태그 칩 (최대 2개) -->
                                                    <ItemsControl VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <ItemsControl.ItemsSource>
                                                            <Binding Path="Tags" Converter="{StaticResource LimitTags}" ConverterParameter="2" />
                                                        </ItemsControl.ItemsSource>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                        CornerRadius="4" Padding="6,1" Margin="4,0,0,0">
                                                                    <ui:TextBlock FontTypography="Caption" Text="{Binding}"
                                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- 인증 전엔 인증/등록 버튼, OTP 통과 후 보기/편집/삭제 3버튼으로 전환 -->
                                                    <Grid>
                                                        <!-- 미인증 슬롯: OTP 등록 여부에 따라 '인증' 또는 'OTP 등록' -->
                                                        <Grid>
                                                            <Grid.Visibility>
                                                                <MultiBinding Converter="{StaticResource EntryVerified}"
                                                                              ConverterParameter="unverified" Mode="OneWay">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.OtpVerifiedIds"
                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </Grid.Visibility>
                                                            <!-- OTP 등록됨: 자물쇠 '인증' -->
                                                            <ui:Button Icon="{ui:SymbolIcon LockClosed24}" ToolTip="인증"
                                                                       Appearance="Transparent"
                                                                       Visibility="{Binding DataContext.HasOtp,
                                                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                                                    Converter={StaticResource BoolToVisibility}}"
                                                                       Command="{Binding DataContext.VerifyCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}" />
                                                            <!-- OTP 미등록: 등록 화면으로 유도 -->
                                                            <ui:Button Content="OTP 등록" Icon="{ui:SymbolIcon Key24}"
                                                                       Appearance="Secondary"
                                                                       Visibility="{Binding DataContext.RequiresOtpSetup,
                                                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                                                    Converter={StaticResource BoolToVisibility}}"
                                                                       Command="{Binding DataContext.VerifyCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}" />
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Visibility>
                                                                <MultiBinding Converter="{StaticResource EntryVerified}"
                                                                              ConverterParameter="verified" Mode="OneWay">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.OtpVerifiedIds"
                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </StackPanel.Visibility>
                                                            <ui:Button Icon="{ui:SymbolIcon Eye24}" ToolTip="보기"
                                                                       Command="{Binding DataContext.RevealCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}" />
                                                            <ui:Button Icon="{ui:SymbolIcon Edit24}" ToolTip="편집" Margin="4,0,0,0"
                                                                       Command="{Binding DataContext.EditCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}" />
                                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="삭제" Margin="4,0,0,0"
                                                                       Appearance="Danger"
                                                                       Command="{Binding DataContext.DeleteCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                                </Grid>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <!-- 즐겨찾기 켜짐: 별을 채우고 강조색으로 -->
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter TargetName="PinIcon" Property="Filled" Value="True" />
                                                    <Setter TargetName="PinIcon" Property="Foreground"
                                                            Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <!-- 즐겨찾기 그룹 안의 행일 때만 사이트명을 함께 보여준다.
                                                     가장 가까운 ItemsControl(계정 목록)의 DataContext가 그 그룹이다. -->
                                                <DataTrigger Value="True"
                                                             Binding="{Binding DataContext.IsFavorites,
                                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <Setter TargetName="SiteInline" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="SiteSeparator" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- 즐겨찾기 그룹: 사이트가 아니라 핀한 계정 모음이라 이니셜 아바타가 의미 없다 -->
                            <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                                <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="FavoritesBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
