<UserControl x:Class="PasswordManager.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- 태그 필터 칩: 각진 버튼 대신 둥근 알약. 켜지면 강조색, 아니면 은은한 배경 -->
        <Style x:Key="TagChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="{StaticResource ThicknessL}">
        <!-- 상단 도구모음: 검색 + 새 항목 (보조 동작은 설정 화면으로 이전) -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="검색 (사이트·아이디)"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Content="새 항목" Icon="{ui:SymbolIcon Add24}"
                       Appearance="Primary" Margin="8,0,0,0" Command="{Binding NewEntryCommand}" />
        </Grid>

        <!-- 태그 필터 칩 바 (TD-029: 여러 개 선택 시 OR). 태그가 있을 때만 표시 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16"
              Visibility="{Binding AvailableTags.Count, Converter={StaticResource CountToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 태그가 많아도 세로 공간을 잡아먹지 않도록 한 줄 고정 + 가로 스크롤(TD-030) -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding AvailableTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource TagChipStyle}" Margin="0,0,6,0"
                                          Command="{Binding DataContext.ToggleTagCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}">
                                <ToggleButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource TagSelected}" Mode="OneWay">
                                        <Binding />
                                        <Binding Path="DataContext.SelectedTags"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </ToggleButton.IsChecked>
                                <TextBlock Text="{Binding StringFormat='#{0}'}" />
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ui:Button Grid.Column="1" Content="지우기" Icon="{ui:SymbolIcon Dismiss24}"
                       Appearance="Secondary" Margin="8,0,0,0" VerticalAlignment="Top"
                       Command="{Binding ClearTagsCommand}"
                       Visibility="{Binding SelectedTags.Count, Converter={StaticResource CountToVisibility}}" />
        </Grid>

        <!-- 상태 안내 (예: OTP 미등록 시 열람 안내) -->
        <ui:TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{Binding StatusMessage}" TextWrapping="Wrap"
                      Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />

        <!-- 항목 카드 리스트 (design-ux §4) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 사이트 그룹 카드: 헤더(아바타+사이트명) + 계정 행들 -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- 사이트 헤더 -->
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="20"
                                            Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SiteName, Converter={StaticResource Initial}}"
                                                   Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding SiteName}"
                                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                                  TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- 계정 행들 -->
                                <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="52,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 아이디(+복사) + 태그 -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:TextBlock Text="{Binding Login}" VerticalAlignment="Center"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <ui:Button Padding="4" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   Icon="{ui:SymbolIcon Copy16}" FontSize="11" ToolTip="아이디 복사"
                                                                   Visibility="{Binding Login, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                                   Command="{Binding DataContext.CopyLoginCommand,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding Login}" />
                                                    </StackPanel>

                                                    <!-- 태그 칩 (최대 2개) -->
                                                    <ItemsControl Margin="0,4,0,0"
                                                                  ItemsSource="{Binding Tags, Converter={StaticResource LimitTags}, ConverterParameter=2}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                        CornerRadius="4" Padding="6,1" Margin="0,0,4,0">
                                                                    <ui:TextBlock FontTypography="Caption" Text="{Binding}"
                                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- 마지막 변경일 + 액션 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <ui:TextBlock FontTypography="Caption" HorizontalAlignment="Right"
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                  Text="{Binding LastChangedAt, StringFormat='{}{0:yyyy-MM-dd}'}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <ui:Button Icon="{ui:SymbolIcon Eye24}" ToolTip="보기"
                                                                   Command="{Binding DataContext.RevealCommand,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}" />
                                                        <ui:Button Icon="{ui:SymbolIcon Edit24}" ToolTip="편집" Margin="4,0,0,0"
                                                                   Command="{Binding DataContext.EditCommand,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}" />
                                                        <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="삭제" Margin="4,0,0,0"
                                                                   Appearance="Danger"
                                                                   Command="{Binding DataContext.DeleteCommand,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
