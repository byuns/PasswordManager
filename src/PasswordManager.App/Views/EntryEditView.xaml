<UserControl x:Class="PasswordManager.App.Views.EntryEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:EntryEditViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <Grid MaxWidth="620" MinWidth="360" HorizontalAlignment="Stretch" Margin="40,32">
            <StackPanel>
                <ui:TextBlock FontTypography="Title" Margin="0,0,0,24"
                              Text="{Binding IsNew, Converter={StaticResource BoolToTitle}}" />

            <ui:TextBlock Margin="0,0,0,4">
                <Run Text="사이트명" />
                <Run Text="*" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </ui:TextBlock>
            <!-- 이미 쓰는 사이트는 드롭다운에서 고르면 URL·태그가 함께 채워지고,
                 목록에 없으면 그대로 타이핑해 직접 입력한다(TD-046). -->
            <ComboBox x:Name="TitleInput" IsEditable="True" StaysOpenOnEdit="True"
                      ItemsSource="{Binding KnownSites}"
                      Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                      SelectionChanged="TitleInput_SelectionChanged" />

            <ui:TextBlock Text="주소(URL)" Margin="0,12,0,4" />
            <ui:TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />

            <ui:TextBlock Margin="0,12,0,4">
                <Run Text="아이디" />
                <Run Text="*" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </ui:TextBlock>
            <ui:TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

            <ui:TextBlock Margin="0,12,0,4">
                <Run Text="비밀번호" />
                <Run Text="*" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </ui:TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 눈 버튼(RevealButtonEnabled)으로 지금 입력한 비번을 직접 확인할 수 있다(TD-047).
                     기존 비번을 고정 마스킹으로 보여주는 동안에는 code-behind가 버튼을 감춘다. -->
                <ui:PasswordBox x:Name="PasswordInput" Grid.Column="0" RevealButtonEnabled="True"
                                PasswordChanged="PasswordInput_PasswordChanged"
                                GotKeyboardFocus="PasswordInput_GotKeyboardFocus"
                                LostKeyboardFocus="PasswordInput_LostKeyboardFocus" />
                <ui:Button Grid.Column="1" Content="생성" Icon="{ui:SymbolIcon Password24}"
                           Margin="8,0,0,0" Command="{Binding GeneratePasswordCommand}" />
            </Grid>

            <!-- 생성 옵션 -->
            <Expander Header="생성 옵션" Margin="0,8,0,0">
                <StackPanel Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:TextBlock Text="길이" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:NumberBox Value="{Binding GeneratorLength, Mode=TwoWay}"
                                      Minimum="8" Maximum="64" Width="120" />
                    </StackPanel>
                    <WrapPanel>
                        <CheckBox Content="대문자" IsChecked="{Binding GenUppercase}" Margin="0,0,12,0" />
                        <CheckBox Content="소문자" IsChecked="{Binding GenLowercase}" Margin="0,0,12,0" />
                        <CheckBox Content="숫자" IsChecked="{Binding GenDigits}" Margin="0,0,12,0" />
                        <CheckBox Content="기호" IsChecked="{Binding GenSymbols}" Margin="0,0,12,0" />
                        <CheckBox Content="혼동 문자 제외" IsChecked="{Binding GenExcludeAmbiguous}" />
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <ui:TextBlock Text="태그" Margin="0,12,0,4" />
            <!-- 확정된 태그 칩(각 ✕로 삭제) -->
            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,0,0,6"
                          Visibility="{Binding Tags.Count, Converter={StaticResource CountToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="12" Padding="10,3" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Caption" VerticalAlignment="Center"
                                              Text="{Binding StringFormat='#{0}'}" />
                                <ui:Button Appearance="Transparent" Content="✕" FontSize="10" Padding="4,0"
                                           MinWidth="0" Margin="4,0,-4,0" VerticalAlignment="Center" ToolTip="태그 삭제"
                                           Command="{Binding DataContext.RemoveTagCommand,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 태그 입력: # 붙여 입력하고 Space 또는 Enter로 칩 추가 -->
            <ui:TextBox Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="#태그 입력 후 Space 또는 Enter"
                        PreviewKeyDown="TagInput_PreviewKeyDown" />

            <ui:TextBlock Text="메모" Margin="0,12,0,2" />
            <!-- 메모는 OTP 없이 hover로 바로 보이므로 민감정보 입력을 경고한다 -->
            <ui:TextBlock FontTypography="Caption" Margin="0,0,0,4"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="⚠ 비밀번호·주민번호 등 중요한 정보는 적지 마세요. 메모는 인증 없이 보입니다." />
            <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <ui:Button Content="취소" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="저장" Appearance="Primary" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
