<UserControl x:Class="PasswordManager.App.Views.EntryEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:EntryEditViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Loaded="OnLoaded">
    <Grid MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
        <StackPanel>
            <ui:TextBlock FontTypography="Title" Margin="0,0,0,16"
                          Text="{Binding IsNew, Converter={StaticResource BoolToTitle}}" />

            <ui:TextBlock Text="제목" Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <ui:TextBlock Text="주소(URL)" Margin="0,12,0,4" />
            <ui:TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />

            <ui:TextBlock Text="아이디" Margin="0,12,0,4" />
            <ui:TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

            <ui:TextBlock Text="비밀번호" Margin="0,12,0,4" />
            <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged" />

            <ui:TextBlock Text="메모" Margin="0,12,0,4" />
            <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="취소" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <ui:Button Content="저장" Appearance="Primary" Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
