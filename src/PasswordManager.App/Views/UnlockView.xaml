<UserControl x:Class="PasswordManager.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:UnlockViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="FormScroll">
    <Grid MinHeight="{Binding ViewportHeight, ElementName=FormScroll}">
    <!-- 너비 고정: 입력한 비밀번호 길이에 따라 카드가 늘었다 줄었다 하지 않도록 Width를 못박는다. -->
    <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="40">
        <StackPanel>
            <ui:SymbolIcon Symbol="LockClosed24" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Margin="0,0,0,12" />
            <ui:TextBlock FontTypography="Title" Text="잠금 해제" HorizontalAlignment="Center"
                          Margin="0,0,0,24" />

            <ui:TextBlock Text="마스터 비밀번호" Margin="0,0,0,4" />
            <ui:PasswordBox x:Name="PasswordInput" PlaceholderText="비밀번호 입력"
                            PasswordChanged="PasswordInput_PasswordChanged" />

            <ui:TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                          Text="{Binding ErrorMessage}"
                          Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
                          TextWrapping="Wrap" Margin="0,8,0,0" />

            <ui:Button Content="열기" Appearance="Primary" IsDefault="True" HorizontalAlignment="Stretch"
                       Margin="0,20,0,0" Command="{Binding UnlockCommand}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            <ProgressBar IsIndeterminate="True" Margin="0,12,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <ui:HyperlinkButton Content="비밀번호를 잊으셨나요?" HorizontalAlignment="Center"
                                Margin="0,12,0,0" Command="{Binding ForgotPasswordCommand}" />

            <!-- 파일 손상이 감지됐을 때만 노출되는 복원 CTA (S9·TD-028) -->
            <ui:Button Content="백업에서 복원" Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                       Command="{Binding RestoreCommand}"
                       Visibility="{Binding IsCorrupted, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
