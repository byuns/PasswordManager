<UserControl x:Class="PasswordManager.App.Views.TrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:TrashViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <DockPanel Margin="{StaticResource ThicknessL}">
        <!-- 머리말: 뒤로 + 제목 + 비우기 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="설정으로"
                       Appearance="Transparent" Margin="0,0,8,0" Command="{Binding CloseCommand}" />
            <ui:TextBlock Grid.Column="1" FontTypography="Title" Text="휴지통" VerticalAlignment="Center" />
            <ui:Button Grid.Column="2" Content="휴지통 비우기" Icon="{ui:SymbolIcon Delete24}"
                       Appearance="Danger" VerticalAlignment="Center"
                       Command="{Binding EmptyTrashCommand}" />
        </Grid>

        <ui:TextBlock DockPanel.Dock="Top" Margin="0,0,0,16" TextWrapping="Wrap"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run Text="삭제한 계정은 여기에" />
            <Run Text="{Binding RetentionDays, Mode=OneWay}" />
            <Run Text="일간 보관되며, 기간이 지나면 잠금 해제 시 자동으로 완전히 지워집니다." />
        </ui:TextBlock>

        <!-- 빈 상태 -->
        <StackPanel DockPanel.Dock="Top" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="0,48,0,0"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <ui:SymbolIcon Symbol="Delete24" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ui:TextBlock Text="휴지통이 비어 있습니다." Margin="0,12,0,0" HorizontalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 삭제된 계정 목록 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TrashItem}">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 이니셜 아바타 (계정 목록과 같은 표현, 흐리게) -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Entry.Title, Converter={StaticResource Initial}}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Entry.Title}"
                                                  TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <ui:TextBlock Text="{Binding Entry.Login}"
                                                      TextTrimming="CharacterEllipsis"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:TextBlock Margin="8,0,0,0" FontTypography="Caption"
                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="·" />
                                            <Run Text="{Binding DaysLeft, Mode=OneWay}" />
                                            <Run Text="일 뒤 완전 삭제" />
                                        </ui:TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="복원" Icon="{ui:SymbolIcon ArrowUndo24}"
                                               Command="{Binding DataContext.RestoreCommand,
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="영구 삭제"
                                               Appearance="Danger" Margin="6,0,0,0"
                                               Command="{Binding DataContext.PurgeCommand,
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
