<UserControl x:Class="PasswordManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PasswordManager.ViewModels;assembly=PasswordManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24,20,24">
        <StackPanel>
            <ui:TextBlock FontTypography="Title" Text="설정" Margin="0,0,0,20" />

            <!-- 보안 -->
            <ui:TextBlock FontTypography="BodyStrong" Text="보안"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,0,0,8" />

            <ui:CardControl Icon="{ui:SymbolIcon ShieldKeyhole24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="2단계 인증(OTP)" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{Binding OtpStatusText, StringFormat='비밀번호 열람 보호 · 현재: {0}'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{Binding OtpActionLabel}" Command="{Binding SetupOtpCommand}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Key24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="마스터 비밀번호" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="볼트를 여는 마스터 비밀번호를 변경합니다." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="변경" Command="{Binding ChangeMasterPasswordCommand}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon KeyReset24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="복구 키 재발급" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="새 복구 키를 발급하면 이전 복구 키는 더 이상 쓸 수 없습니다." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="재발급" Command="{Binding ReissueRecoveryCommand}" />
            </ui:CardControl>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Timer24" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="BodyStrong" Text="자동 잠금 · 클립보드" />
                            <ui:TextBlock FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="유휴 자동 잠금(분)과 비밀번호 복사 후 클립보드 삭제(초) 시간." />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,16,0">
                            <ui:TextBlock FontTypography="Caption" Text="잠금(분)" Margin="0,0,0,2" />
                            <ui:NumberBox Width="120" Minimum="1" Maximum="120" SmallChange="1"
                                          ClearButtonEnabled="False"
                                          Value="{Binding AutoLockMinutes, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <ui:TextBlock FontTypography="Caption" Text="클립보드(초)" Margin="0,0,0,2" />
                            <ui:NumberBox Width="120" Minimum="5" Maximum="300" SmallChange="5"
                                          ClearButtonEnabled="False"
                                          Value="{Binding ClipboardClearSeconds, Mode=TwoWay}" />
                        </StackPanel>
                        <ui:Button Content="저장" VerticalAlignment="Bottom"
                                   Command="{Binding SaveTimeSettingsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 알림 (네트워크·슬랙) -->
            <ui:TextBlock FontTypography="BodyStrong" Text="알림"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,16,0,8" />

            <ui:CardControl Icon="{ui:SymbolIcon Globe24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="네트워크 사용 허용" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="기본은 오프라인(차단)입니다. 슬랙 알림을 쓰려면 먼저 켜세요." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding NetworkAllowed, Mode=TwoWay}" />
            </ui:CardControl>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="16" Margin="0,0,0,8"
                    IsEnabled="{Binding NetworkAllowed}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Alert24" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="BodyStrong" Text="슬랙 알림" />
                            <ui:TextBlock FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="자리를 비운 사이 무단 접근을 폰으로 탐지합니다. 비밀번호는 전송되지 않습니다." />
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding SlackEnabled, Mode=TwoWay}"
                                         HorizontalAlignment="Right" Margin="16,0,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" IsEnabled="{Binding SlackEnabled}">
                        <ui:TextBlock FontTypography="Caption" Text="Webhook URL" Margin="0,0,0,2" />
                        <ui:TextBox PlaceholderText="https://hooks.slack.com/services/..."
                                    Text="{Binding SlackWebhookUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:TextBlock FontTypography="Caption" Text="알림 이벤트" Margin="0,12,0,4" />
                        <CheckBox Content="잠금 해제 성공" IsChecked="{Binding NotifyUnlock, Mode=TwoWay}" />
                        <CheckBox Content="로그인 실패" IsChecked="{Binding NotifyLoginFailure, Mode=TwoWay}" />
                        <CheckBox Content="비밀번호 추가·변경" IsChecked="{Binding NotifyPasswordChange, Mode=TwoWay}" />
                        <CheckBox Content="민감 이벤트(마스터 변경·복구 키 재발급)" IsChecked="{Binding NotifySensitive, Mode=TwoWay}" />
                        <CheckBox Content="사이트명 포함(기본 미포함)" Margin="0,4,0,0"
                                  IsChecked="{Binding IncludeSiteName, Mode=TwoWay}" />

                        <ui:TextBlock FontTypography="Caption" Text="메시지 템플릿 · 허용 변수 {이벤트} {시각} {기기명}"
                                      Margin="0,12,0,2" />
                        <ui:TextBox Text="{Binding MessageTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBlock FontTypography="Caption" Text="기기명(선택, {기기명} 변수용)" Margin="0,8,0,2" />
                        <ui:TextBox Text="{Binding DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:TextBlock FontTypography="Caption" Text="미리보기" Margin="0,12,0,2"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12">
                            <ui:TextBlock Text="{Binding TemplatePreview}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <!-- 저장은 네트워크 허용 상태에서 항상 가능(슬랙 OFF로 두고 네트워크만 켜는 것도 저장 가능). -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button Content="기본 템플릿" Command="{Binding ResetTemplateCommand}" Margin="0,0,8,0"
                                   IsEnabled="{Binding SlackEnabled}" />
                        <ui:Button Content="저장" Appearance="Primary" Command="{Binding SaveSlackSettingsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 데이터 -->
            <ui:TextBlock FontTypography="BodyStrong" Text="데이터"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,16,0,8" />

            <ui:CardControl Icon="{ui:SymbolIcon Save24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="볼트 백업" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="암호화된 볼트를 파일로 내보냅니다." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="백업" Command="{Binding BackupCommand}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon ArrowImport24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="볼트 복원" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="백업 파일로 현재 볼트를 덮어씁니다(복원 후 재로그인)." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="복원" Appearance="Caution" Command="{Binding RestoreCommand}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon DocumentArrowRight24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="CSV 내보내기" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                      Text="⚠ 비밀번호가 평문으로 저장됩니다. 안전한 곳에만 보관하세요." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="내보내기" Appearance="Caution" Command="{Binding ExportCommand}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon DocumentArrowLeft24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="CSV 가져오기" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="CSV 파일의 계정을 모두 새 계정으로 추가합니다." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="가져오기" Command="{Binding ImportCommand}" />
            </ui:CardControl>

            <!-- 휴지통 (TD-041): 삭제한 계정을 되살리는 자리 -->
            <ui:CardControl Icon="{ui:SymbolIcon Delete24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="휴지통" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="삭제한 계정 " /><Run Text="{Binding TrashCount, Mode=OneWay}" /><Run Text="개 · " />
                            <Run Text="{Binding TrashRetentionDays, Mode=OneWay}" /><Run Text="일간 보관 후 자동 삭제" />
                        </ui:TextBlock>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="열기" Command="{Binding OpenTrashCommand}" />
            </ui:CardControl>

            <ui:TextBlock Margin="2,12,0,0"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding StatusMessage}" TextWrapping="Wrap"
                          Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
